# Laravel API origin. Use "localhost" (not 127.0.0.1) consistently so the session
# and XSRF cookies are shared between the two development servers.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Name of Laravel's session cookie (SESSION_COOKIE in backend/.env). Used only by
# src/proxy.ts for an optimistic redirect; the API remains the authority.
NEXT_PUBLIC_SESSION_COOKIE=lexora_session

# DEVELOPMENT ONLY — shows the demo credentials on the login page. Leave empty in production.
NEXT_PUBLIC_DEMO_EMAIL=admin@lexora.test
NEXT_PUBLIC_DEMO_PASSWORD=Lexora!Demo2026
