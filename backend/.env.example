# ---------------------------------------------------------------------------
# Lexora Workspace API — environment template
# Copy to .env and run `php artisan key:generate`.
# ---------------------------------------------------------------------------
APP_NAME="Lexora Workspace"
APP_ENV=local
APP_KEY=
# Never enable debug in production: it exposes stack traces.
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origin of the Next.js frontend (used for CORS and Sanctum stateful domains).
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (docker compose service `postgres`, exposed on localhost:5432)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=amanet
DB_USERNAME=amanet
DB_PASSWORD=amanet

# Session-based Sanctum SPA authentication (HTTP-only cookie).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leave empty for localhost development. In production set e.g. ".lexora.example".
SESSION_DOMAIN=
SESSION_COOKIE=lexora_session
# Left unset on purpose: the cookie is then Secure (HTTPS only) whenever APP_ENV=production and plain for local
# http://localhost development. Never set it to false on a server.
# SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

# Hosts (host:port) whose browser requests are authenticated with the session cookie.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# E-mail (Phase 6). Development: the project's Mailpit (docker compose; set MAIL_PORT to LEXORA_MAIL_SMTP_PORT
# if you changed it). Production: your SMTP provider — put the username/password in the server's secret store,
# never in a committed file. See docs/email-configuration.md.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="workspace@lexora.test"
MAIL_FROM_NAME="${APP_NAME}"
# Optional: where client replies go, and footer details (nothing is shown when empty).
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME=
LEXORA_FIRM_CONTACT_EMAIL=
LEXORA_FIRM_POSTAL_ADDRESS=
# Development only: Mailpit web UI, linked from the send dialog after an accepted e-mail. Leave empty in production.
LEXORA_MAIL_UI_URL=http://localhost:8025
# false = no e-mail at all (Copy link only). Reminders can be switched off separately.
LEXORA_EMAIL_ENABLED=true
LEXORA_REMINDERS_ENABLED=true
LEXORA_REMINDER_MAX_PER_REQUEST=3
LEXORA_REMINDER_MIN_INTERVAL_HOURS=24

# Dashboard: how many days ahead count as an "upcoming" deadline.
LEXORA_UPCOMING_WINDOW_DAYS=14

# The firm's time zone. Deadlines and opening dates are calendar dates in this zone (a deadline is the
# end of that day); all timestamps are stored in UTC.
LEXORA_TIMEZONE=UTC

# DEVELOPMENT ONLY — demo administrator created by `php artisan db:seed`.
# The seeder refuses to run in production. Create real admins with
# `php artisan lexora:create-admin`.
DEMO_ADMIN_NAME="Elena Marsh"
DEMO_ADMIN_EMAIL=admin@lexora.test
DEMO_ADMIN_PASSWORD="Lexora!Demo2026"
